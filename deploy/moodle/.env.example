# ---- Stack identity ----
COMPOSE_PROJECT_NAME=qbank

# ---- Domain & ports ----
MOODLE_DOMAIN=qbank.local
MOODLE_HTTPS_PORT=443
MOODLE_HTTP_PORT=8080
WWWROOT=https://qbank.local

# ---- Host data root ----
# Bare-metal workstation (edOS): /srv/qbank     (restic target, EDOS §12)
# WSL dev machine:              ./data          (project-local)
QBANK_ROOT=/srv/qbank

# ---- Images (must exist locally: built via build-image.sh, or docker-load'ed) ----
MOODLE_IMAGE=qbank/moodle:5.2
POSTGRES_IMAGE=postgres:16

# ---- Database ----
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=__CHANGE_ME__

# ---- Moodle first-run admin (install.php) ----
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=__CHANGE_ME__
MOODLE_ADMIN_EMAIL=admin@qbank.local
MOODLE_SITE_NAME=QBank

# ---- Passwords salt (generated once, backed up with the DB) ----
PASSWORDSALTMAIN=

# ---- DB host inside the compose network (leave as-is) ----
DBHOST=db
