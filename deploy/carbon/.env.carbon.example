# ─────────────────────────────────────────────────────────────────
#  Carbon Data Trust Platform  ·  carbon.clearturn.tech  ·  /srv/carbon
#  Copy this file to:  backend/.env.carbon
#  then fill in every CHANGE_ME value before deploying.
#
#  Architecture:
#    - Backend:  Docker (Gunicorn) on 127.0.0.1:8002
#    - Frontend: React SPA served by nginx on host
#    - Database: PostgreSQL on host (host.docker.internal:5432)
#    - Static/Media: Volume-mounted from host
# ─────────────────────────────────────────────────────────────────

# ── Deploy infrastructure (also read by deploy/redeploy scripts) ──
DOMAIN=carbon.clearturn.tech
BACKEND_PORT=8002

# ── Instance identity (ADR-0015: one codebase, N isolated deployments) ──
INSTANCE=carbon                      # namespaces containers + volumes
DJANGO_INSTANCE_NAME=AASTMT          # drives PLATFORM_TITLE + frontend branding

# Django core
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_python_-c_import_secrets_print_secrets.token_urlsafe_50

# Allowed hosts: domain + server IP
DJANGO_ALLOWED_HOSTS=carbon.clearturn.tech,127.0.0.1,localhost

# ── PostgreSQL (on host, accessed via host.docker.internal) ───────
#  OWN database — completely separate from gigacast and carbon_dev.
DB_NAME=carbon_prod
DB_USER=carbon_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_HOST=host.docker.internal
DB_PORT=5432

# ── CORS / CSRF ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://carbon.clearturn.tech
# Required: must include the domain so Django admin/API POSTs don't return 403
CSRF_TRUSTED_ORIGINS=https://carbon.clearturn.tech

# ── API prefix ───────────────────────────────────────────────────
DJANGO_API_PREFIX=/carbon-api/

# ── Static / Media ────────────────────────────────────────────────
# These paths are inside the container; the volumes map them to host
DJANGO_STATIC_ROOT=/static
DJANGO_MEDIA_ROOT=/media
DATASCHEMA_UPLOAD_PATH=dataschema_uploads/

# ── SSL / Security ────────────────────────────────────────────────
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# ── Emissions ─────────────────────────────────────────────────────
EMISSIONS_AUTO_CALC=True

# ── App activation (ADR-0015) — the per-instance app subset ───────
# Comma-separated AppManifest slugs to activate on deploy. System apps
# stay active regardless. Empty → activate_apps --all (full platform).
APP_ACTIVE_SLUGS=
