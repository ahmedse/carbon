# ─────────────────────────────────────────────────────────────────
#  Carbon instance env template (ADR-0015)
#
#  Copy to deploy/<instance>/.env  AND  backend/.env.<instance>,
#  then fill every CHANGE_ME before deploying.
#
#  One codebase, many isolated deployments. INSTANCE is the ONLY
#  thing that disambiguates this deployment's containers, volumes,
#  database, domain, and branding.
#
#  ── Prod topology (identical to deploy/carbon/) ──────────────────
#    Backend   : Docker (Gunicorn) → 127.0.0.1:${BACKEND_PORT}
#    Frontend  : React SPA served by nginx on HOST (dist/)
#    PostgreSQL: on HOST, via host.docker.internal:5432
#    Redis     : on HOST, via host.docker.internal:6379 (cache/queue)
#  ─────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────

# ── Instance identity ─────────────────────────────────────────────
INSTANCE=CHANGE_ME                      # e.g. aast | nibras | healthy
ENV_FILE=../../backend/.env.CHANGE_ME

# ── Deploy infrastructure ─────────────────────────────────────────
DOMAIN=CHANGE_ME.example.com
# ⚠ UNIQUE per instance on the host. carbon=8006, nibras=8008, medos=8009, tectona=8010.
#   Two instances must NEVER share BACKEND_PORT. deploy-instance.sh
#   refuses to start if this port is already listening.
BACKEND_PORT=8008

# ── Branding (drives PLATFORM_TITLE + frontend VITE_*) ────────────
DJANGO_INSTANCE_NAME=CHANGE_ME          # e.g. AASTMT | Nibras | Healthy Foods
# Brand id → backend BRAND_APP_PRESETS + frontend src/brands/*.js.
# Must match a key in settings.BRAND_APP_PRESETS (aastmt|nibras|medos|tectona).
# auto-deploy.sh derives VITE_BRAND from this (single source of truth).
DJANGO_BRAND=aastmt

# ── Django core ───────────────────────────────────────────────────
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_python_-c_import_secrets_print_secrets.token_urlsafe_50
DJANGO_ALLOWED_HOSTS=CHANGE_ME.example.com,127.0.0.1,localhost

# ── PostgreSQL (host, via host.docker.internal) — OWN DB ──────────
DB_NAME=CHANGE_ME_prod
DB_USER=CHANGE_ME_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_HOST=host.docker.internal
DB_PORT=5432

# ── Redis (host, via host.docker.internal) — cache + async queue ──
# ⚠ Use a UNIQUE DB index per instance (nibras=1, medos=2, ...) so
#   instances don't share cache/queue keyspaces on one Redis server.
REDIS_URL=redis://host.docker.internal:6379/1

# ── CORS / CSRF ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example.com
CSRF_TRUSTED_ORIGINS=https://CHANGE_ME.example.com

# ── API prefix ────────────────────────────────────────────────────
DJANGO_API_PREFIX=/carbon-api/

# ── Static / Media (paths inside the container) ───────────────────
DJANGO_STATIC_ROOT=/static
DJANGO_MEDIA_ROOT=/media
DATASCHEMA_UPLOAD_PATH=dataschema_uploads/

# ── SSL / Security ────────────────────────────────────────────────
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# ── App activation (ADR-0015) — the per-instance app subset ───────
# Comma-separated AppManifest slugs to activate on deploy. System
# apps stay active regardless. Empty → activate_apps --all.
APP_ACTIVE_SLUGS=emissions
