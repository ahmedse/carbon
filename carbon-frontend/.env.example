# ============================================================================
# FRONTEND CONFIGURATION - EXAMPLE FILE
# ============================================================================
# Copy this file to .env and customize for your environment
# This is the SINGLE SOURCE OF TRUTH for frontend configuration
# ============================================================================

# ----------------------------------------------------------------------------
# ROUTING CONFIGURATION
# ----------------------------------------------------------------------------
# Vite base path. All routes in App.jsx are already prefixed with /carbon/,
# so VITE_BASE must be "/" to avoid double-prefixing (/carbon/carbon/*).
# If deploying without the /carbon/ prefix in routes, set VITE_BASE=/carbon/ and
# remove the /carbon/ prefix from all Routes in App.jsx.
VITE_BASE=/

# ----------------------------------------------------------------------------
# BACKEND API CONFIGURATION (CRITICAL!)
# ----------------------------------------------------------------------------
# This MUST match the backend configuration exactly!
#
# Backend runs on: http://localhost:8000
# Backend API prefix: /api/v1/ (from backend/.env DJANGO_API_PREFIX)
# Full API URL: http://localhost:8000/api/v1/
#
# IMPORTANT RULES:
# 1. Include protocol (http:// or https://)
# 2. Include host and port
# 3. Include API prefix (/api/v1/)
# 4. Include trailing slash
# 5. MUST match backend DJANGO_API_PREFIX
#
# Examples:
#   Development: http://localhost:8000/api/v1/
#   Staging:     https://api-staging.example.com/api/v1/
#   Production:  https://api.example.com/api/v1/
VITE_API_BASE_URL=http://localhost:8000/api/v1/

# ----------------------------------------------------------------------------
# API TIMEOUT (OPTIONAL)
# ----------------------------------------------------------------------------
# Timeout for API requests in milliseconds
# Default: 30000 (30 seconds)
VITE_API_TIMEOUT=30000

# ----------------------------------------------------------------------------
# PULSE AI COPILOT INTEGRATION
# ----------------------------------------------------------------------------
# Pulse service host URL (include protocol and port)
VITE_PULSE_HOST=http://127.0.0.1:9100

# Instance ID for Pulse (matches backend configuration)
VITE_PULSE_INSTANCE_ID=carbon

# ----------------------------------------------------------------------------
# PLATFORM BRANDING (MULTI-CUSTOMER)
# ----------------------------------------------------------------------------
# These drive all UI text, logos, and favicons.
# Change VITE_INSTANCE_NAME and VITE_INSTANCE_LOGO per customer deployment.
#
VITE_PLATFORM_NAME=Carbon Data Trust
VITE_PLATFORM_SHORT=Carbon

# Instance (customer-specific)
VITE_INSTANCE_NAME=AASTMT
# Place customer logo in public/logos/ then uncomment:
# VITE_INSTANCE_LOGO=/logos/aastmt.svg
# VITE_INSTANCE_FAVICON=/logos/aastmt-favicon.svg

# ----------------------------------------------------------------------------
# VALIDATION
# ----------------------------------------------------------------------------
# After creating your .env file:
# 1. Check backend/.env has: DJANGO_API_PREFIX=/api/v1/
# 2. Check backend is running: python manage.py runserver
# 3. Start frontend: npm run dev
# 4. Check browser console for "✅ API reachable" message
#
# If you see 404 errors:
# - Verify VITE_API_BASE_URL matches backend URL + API prefix
# - Restart both servers after changing .env files
# - Check CORS_ALLOWED_ORIGINS in backend/.env includes your frontend URL
# ============================================================================
