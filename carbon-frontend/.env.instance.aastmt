# ============================================================================
# INSTANCE PRESET: AASTMT Data Trust
# ClearTurn Trust Platform — Arab Academy for Science, Technology & Maritime Transport
# ============================================================================
# Usage: cp .env.instance.aastmt .env  (then adjust API URL / ports for environment)
# Deployed at: carbon.clearturn.tech

VITE_BASE=/
VITE_API_BASE_URL=https://carbon.clearturn.tech/carbon-api/
VITE_API_TIMEOUT=30000

# Pulse
VITE_PULSE_HOST=http://127.0.0.1:9100
VITE_PULSE_INSTANCE_ID=aastmt

# Branding
VITE_BRAND=aastmt
VITE_PLATFORM_NAME=Data Trust Platform
VITE_PLATFORM_SHORT=Data Trust
VITE_PLATFORM_TITLE=AASTMT · Data Trust Platform
VITE_PLATFORM_TAGLINE=Trusted data platform hosting domain applications
VITE_PLATFORM_DESCRIPTION=A governed data platform for data catalog, master data management, data quality, and domain applications.
VITE_INSTANCE_NAME=AASTMT
# VITE_INSTANCE_LOGO=/logos/aastmt.svg
# VITE_INSTANCE_FAVICON=/logos/aastmt-favicon.svg

# Enabled apps (informational — enforced by backend appregistry, not this env)
# carbon, (future: performarc, research-lifecycler, facilities-labs, sustainability-goals)

VITE_CANONICAL_URL=https://carbon.clearturn.tech
