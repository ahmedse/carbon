# ============================================================================
# INSTANCE PRESET: ClearTurn EduOS
# ClearTurn Trust Platform — ClearTurn's education operating system
# ============================================================================
# Usage: cp .env.instance.eduos .env  (then adjust API URL / ports for environment)
# Deployed at: eduos.clearturn.tech
# Flagship app: GradeVance (assessment + coaching)

VITE_BASE=/
VITE_API_BASE_URL=https://eduos.clearturn.tech/carbon-api/
VITE_API_TIMEOUT=30000

# One-switch brand (resolves name/logo/palette/apps from src/brands/eduos.js)
VITE_BRAND=eduos

# Branding (mirrors src/brands/eduos.js — drives the static <title> in index.html)
VITE_PLATFORM_NAME=EduOS
VITE_PLATFORM_SHORT=EduOS
VITE_PLATFORM_TITLE=ClearTurn · EduOS
VITE_PLATFORM_TAGLINE=Education Operating System
VITE_PLATFORM_DESCRIPTION=EduOS is ClearTurn's education platform — multi-domain assessment, coaching, and academic workflow apps. Flagship app: GradeVance.
VITE_INSTANCE_NAME=ClearTurn

# Pulse
VITE_PULSE_HOST=http://127.0.0.1:9100
VITE_PULSE_INSTANCE_ID=eduos

VITE_CANONICAL_URL=https://eduos.clearturn.tech
