# ============================================================================
# INSTANCE PRESET: ClearTurn Tectona
# ClearTurn Trust Platform — ClearTurn's own AI platform instance
# ============================================================================
# Usage: cp .env.instance.tectona .env  (then adjust API URL / ports for environment)
# Deployed at: tectona.clearturn.tech

VITE_BASE=/
VITE_API_BASE_URL=https://tectona.clearturn.tech/carbon-api/
VITE_API_TIMEOUT=30000

# Pulse
VITE_PULSE_HOST=http://127.0.0.1:9100
VITE_PULSE_INSTANCE_ID=tectona

# Branding
VITE_PLATFORM_NAME=Tectona
VITE_PLATFORM_SHORT=Tectona
VITE_PLATFORM_TAGLINE=AI-Powered Operations Intelligence
VITE_PLATFORM_DESCRIPTION=Tectona is ClearTurn's AI platform — hosting the Healthy factory AI apps and future ClearTurn first-party intelligence applications.
VITE_INSTANCE_NAME=ClearTurn
# VITE_INSTANCE_LOGO=/logos/clearturn.svg
# VITE_INSTANCE_FAVICON=/logos/tectona-favicon.svg

# Enabled apps (informational — enforced by backend appregistry, not this env)
# healthy

VITE_CANONICAL_URL=https://tectona.clearturn.tech
