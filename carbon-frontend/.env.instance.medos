# ============================================================================
# INSTANCE PRESET: ClearTurn medOS
# ClearTurn Trust Platform — ClearTurn's healthcare operations OS
# ============================================================================
# Usage: cp .env.instance.medos .env  (then adjust API URL / ports for environment)
# Deployed at: medos.clearturn.tech

VITE_BASE=/
VITE_API_BASE_URL=https://medos.clearturn.tech/carbon-api/
VITE_API_TIMEOUT=30000

# One-switch brand (resolves name/logo/palette/apps from src/brands/medos.js)
VITE_BRAND=medos

# Branding (mirrors src/brands/medos.js — drives the static <title> in index.html)
VITE_PLATFORM_NAME=medOS
VITE_PLATFORM_SHORT=medOS
VITE_PLATFORM_TITLE=ClearTurn · medOS

# Pulse
VITE_PULSE_HOST=http://127.0.0.1:9100
VITE_PULSE_INSTANCE_ID=medos

VITE_CANONICAL_URL=https://medos.clearturn.tech
