# ============================================================================
# INSTANCE PRESET: GOFSCO Nibras  نبراس
# ClearTurn Trust Platform — Gas & Oil Field Services Company, Kuwait
# ============================================================================
# Usage: cp .env.instance.nibras .env  (then adjust API URL / ports for environment)
# Deployed at: nibras.clearturn.tech  (or on-prem at GOFSCO)

VITE_BASE=/
VITE_API_BASE_URL=https://nibras.clearturn.tech/carbon-api/
VITE_API_TIMEOUT=30000

# Pulse
VITE_PULSE_HOST=http://127.0.0.1:9100
VITE_PULSE_INSTANCE_ID=nibras

# Branding
VITE_PLATFORM_NAME=Nibras
VITE_PLATFORM_SHORT=نبراس
VITE_PLATFORM_TAGLINE=AI-Native Enterprise Platform for Oilfield Services
VITE_PLATFORM_DESCRIPTION=Nibras is an AI-native enterprise platform built on the ClearTurn Trust Platform. HR, inventory, finance, and operations — governed, compliant, intelligent.
VITE_INSTANCE_NAME=GOFSCO
# VITE_INSTANCE_LOGO=/logos/gofsco.svg
# VITE_INSTANCE_FAVICON=/logos/nibras-favicon.svg

# Enabled apps (informational — enforced by backend appregistry, not this env)
# people, stores, fintrust, procurement, assets, projects

VITE_CANONICAL_URL=https://nibras.clearturn.tech
