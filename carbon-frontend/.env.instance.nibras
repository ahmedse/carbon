# ============================================================================
# INSTANCE PRESET: Nibras  نبراس
# ClearTurn Trust Platform — AI-native enterprise business platform
# ============================================================================
# Usage: cp .env.instance.nibras .env  (then adjust API URL / ports for environment)
# Deployed at: nibras.clearturn.tech

VITE_BASE=/
VITE_API_BASE_URL=https://nibras.clearturn.tech/carbon-api/
VITE_API_TIMEOUT=30000

# Pulse
VITE_PULSE_HOST=http://127.0.0.1:9100
VITE_PULSE_INSTANCE_ID=nibras

# Branding
VITE_BRAND=nibras
VITE_PLATFORM_NAME=Nibras
VITE_PLATFORM_SHORT=نبراس
VITE_PLATFORM_TITLE=Nibras · Enterprise Business Platform
VITE_PLATFORM_TAGLINE=AI-native enterprise business domain applications
VITE_PLATFORM_DESCRIPTION=Nibras is a next-generation, AI-native enterprise business platform. Modular domain applications — HR, inventory, finance, procurement, and operations — governed, compliant, and intelligent.
# VITE_INSTANCE_LOGO=/logos/nibras.svg
# VITE_INSTANCE_FAVICON=/logos/nibras-favicon.svg

# Enabled apps (informational — enforced by backend appregistry, not this env)
# people, stores, fintrust, procurement, assets, projects

VITE_CANONICAL_URL=https://nibras.clearturn.tech
