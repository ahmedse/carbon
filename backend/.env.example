 # .env.example

DJANGO_ENV=development
SECRET_KEY=your-very-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_API_PREFIX=/api/v1/

# Set these in production (comma-separated). Leave empty in local dev.
CSRF_TRUSTED_ORIGINS=

# Used in production. In development, the backend allows all origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production security defaults (often True behind HTTPS)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

DJANGO_STATIC_ROOT=./staticfiles/
DJANGO_MEDIA_ROOT=./mediafiles/
DATASCHEMA_UPLOAD_PATH=dataschema_uploads/

# AI Copilot Configuration — the in-process Pulse engine reads LLM_* keys.
# Without LLM_API_KEY + LLM_BASE_URL, chat fails with
# "I couldn't reach the AI service — try again in a moment."
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.poe.com/v1
LLM_MODEL=gpt-4o
LLM_NORMAL_MODEL=gpt-4o
LLM_COGNITION_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=
LLM_DAILY_BUDGET_USD=5.0
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./chroma_db

# Pulse AI Copilot Integration
PULSE_HOST=http://127.0.0.1:9100
PULSE_INSTANCE_ID=carbon
PULSE_JWT_SECRET=changeme-in-production
PULSE_JWT_ALGORITHM=HS256

# AI store backend: "django" = durable (Postgres); "inmemory" = ephemeral.
# Set to "django" for the learning flywheel (real-time trigger + scheduler sweep).
AI_STORE_BACKEND=django

DB_NAME=your_db
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ── TurnKey Bridge (Phase P2) ──────────────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-44-char-fernet-key-here
#   python -c "import secrets; print(secrets.token_hex(32))"
TURNKEY_CALLBACK_SECRET=your-64-char-hex-secret-here