# Line-ending normalization: the repo is authored and deployed on Linux.
# Force LF everywhere so a fresh clone on Windows/WSL can never re-introduce
# CRLF and flag every file as "modified".
* text=auto eol=lf

# Explicitly binary — never normalize these (git content detection is a safety
# net, but being explicit avoids accidental corruption of these assets).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.avi binary
*.mov binary
*.gz binary
*.zip binary
*.tar binary
*.tgz binary
*.rar binary
*.7z binary
*.db binary
*.sqlite3 binary
*.rdb binary
*.pyc binary
*.pyo binary
*.pyd binary
*.so binary
*.dll binary
*.dylib binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Lockfiles are machine-generated; keep LF for stable diffs.
*.lock text eol=lf
